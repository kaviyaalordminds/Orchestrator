# Orchestrator Backend — Environment Configuration
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# ─── Obsidian Local REST API ───────────────────────────────────────────────
# The plugin runs at https://127.0.0.1:27124 by default.
OBSIDIAN_API_URL=https://127.0.0.1:27124

# Find your API key in Obsidian → Settings → Local REST API with MCP
OBSIDIAN_API_KEY=your-obsidian-api-key-here

# Keep False for the local self-signed certificate
OBSIDIAN_VERIFY_SSL=false

# ─── Qdrant Vector Database ────────────────────────────────────────────────
# On-disk path for vector persistence. Leave unset to use the built-in default
# (backend/data/qdrant, resolved automatically relative to this file — see
# app/config.py). Only override if you want the index stored somewhere else;
# if you do, it must be an ABSOLUTE path (Qdrant treats relative paths as
# remote URLs) and it must NOT be a path specific to one person's machine.
# QDRANT_LOCATION=/absolute/path/to/orchestrator/backend/data/qdrant
QDRANT_COLLECTION=obsidian_vault
# Must match the embedding model's output dimension. nomic-embed-text (the
# default EMBEDDING_MODEL below) produces 768-dim vectors.
QDRANT_VECTOR_SIZE=768

# ─── Source Policy ─────────────────────────────────────────────────────────
# When true (default), the chat endpoint answers ONLY from retrieved Obsidian
# context. If the vault has no relevant notes for a query, it returns
# INSUFFICIENT_VAULT_CONTEXT instead of letting the LLM guess from its own
# training knowledge. There is no web-search tool in this project to gate,
# so this flag only controls the vault-context-required behavior.
OBSIDIAN_ONLY=true

# ─── LLM — Ollama (local) ─────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3

# ─── RAG Tuning ────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
# Minimum cosine similarity to treat a vector match as relevant (0-1 range
# in practice for normalized embeddings). Tune against your real vault +
# embedding model. Too low = irrelevant notes leak into answers; too high =
# real matches get discarded as INSUFFICIENT_VAULT_CONTEXT.
RAG_MIN_SCORE=0.35

# ─── Admin API Security ────────────────────────────────────────────────────
# Protect /api/v1/rag/index and /api/v1/rag/reindex
# Generate a strong random string, e.g.:  openssl rand -hex 32
ADMIN_API_KEY=your-admin-api-key-here
